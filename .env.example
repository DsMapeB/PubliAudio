# =============================================================================
# Spotify Audio Interleave — Variables de Entorno
# =============================================================================
# Copia este archivo como .env y ajusta los valores según tu entorno.
# Compatible con Laragon (MySQL/MariaDB).
# =============================================================================

# ──────────────────────────────────────────────
# Base de Datos (MySQL/MariaDB)
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=spotyaudio
DB_USERNAME=root
DB_PASSWORD=

# ──────────────────────────────────────────────
# Spotify API (OAuth 2.0)
# ──────────────────────────────────────────────
# Obtén estas credenciales en:
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIFY_REDIRECT_URI=https://codigos.test/publi/index.php?accion=callback

# ──────────────────────────────────────────────
# Aplicación
# ──────────────────────────────────────────────
APP_NAME=Spotify Audi
DEBUG=true
MAX_AUDIO_SIZE=10
UPLOAD_PATH=uploads/audios
